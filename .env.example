# Local-first defaults. Copy to .env and fill placeholders only.
# Never commit real keys.
#
# Profiles:
#   APP_ENV=local      Redpanda + MinIO only (default). Snowflake optional.
#   APP_ENV=snowflake  Requires SNOWFLAKE_* connection fields below.

APP_ENV=local
LOG_LEVEL=INFO

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_RAW_TICKS=raw-ticks
KAFKA_TOPIC_ENRICHED_TICKS=enriched-ticks
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_DLQ=dlq

# MinIO (S3-compatible lakehouse)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-lake

# Lakehouse table format: jsonl (default, zero extra deps), delta, or iceberg.
# Install extras first: pip install -e ".[lakehouse]"
# Partitioning is always symbol + date.
LAKEHOUSE_FORMAT=jsonl
# Empty = data/{MINIO_BUCKET}. Use s3://market-lake for Delta on MinIO.
LAKEHOUSE_URI=

# Optional Snowflake dual-write (leave empty to disable in APP_ENV=local).
# Required when APP_ENV=snowflake.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Synthetic generator
TICK_SYMBOLS=AAPL,MSFT,GOOG,AMZN,NVDA
TICK_RATE_PER_SEC=50
