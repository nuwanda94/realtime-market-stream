# Local-first defaults. Copy to .env and fill placeholders only.
# Never commit real keys.
#
# Profiles:
#   APP_ENV=local      Redpanda + MinIO only (default). Snowflake optional.
#   APP_ENV=snowflake  Requires SNOWFLAKE_* connection fields below.

APP_ENV=local
LOG_LEVEL=INFO

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_RAW_TICKS=raw-ticks
KAFKA_TOPIC_ENRICHED_TICKS=enriched-ticks
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_DLQ=dlq

# Optional remote Schema Registry (Redpanda / Confluent). Leave empty to use
# bundled JSON Schema files under src/realtime_market_stream/schemas/json/.
SCHEMA_REGISTRY_URL=

# MinIO (S3-compatible lakehouse)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-lake

# Lakehouse table format: jsonl (default, zero extra deps), delta, or iceberg.
# Install extras first: pip install -e ".[lakehouse]"
# Partitioning is always symbol + date.
LAKEHOUSE_FORMAT=jsonl
# Empty = data/{MINIO_BUCKET}. Use s3://market-lake for Delta on MinIO.
LAKEHOUSE_URI=

# Processor checkpoints (offsets + Silver dedup/window state). Gitignored.
CHECKPOINT_DIR=.checkpoints

# Optional Snowflake dual-write (leave empty to disable in APP_ENV=local).
# Required when APP_ENV=snowflake.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_TABLE_TICKS=TICKS
SNOWFLAKE_TABLE_BARS=BARS
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_CHANNEL_NAME=market-stream
SNOWFLAKE_BATCH_SIZE=500
# true = JSONL capture under data/snowflake (zero cloud cost).
# false + configured fields = live INSERT via snowflake-connector-python.
SNOWFLAKE_LOCAL_CAPTURE=true

# Synthetic generator
TICK_SYMBOLS=AAPL,MSFT,GOOG,AMZN,NVDA
TICK_RATE_PER_SEC=50

# Flow control / backpressure (local-first, no extra services).
FLOW_ENABLED=true
FLOW_INGEST_MAX_PER_SEC=0
FLOW_INGEST_BURST=100
FLOW_PRODUCER_MAX_INFLIGHT=500
FLOW_PRODUCER_BLOCK_TIMEOUT_SEC=5
FLOW_API_REQUESTS_PER_SEC=50
FLOW_API_BURST=100

# OpenTelemetry (optional). Off by default — no collector required.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=realtime-market-stream
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1.0
