# Local-first defaults. Copy to .env and fill placeholders only.
# Never commit real keys.

APP_ENV=local
LOG_LEVEL=INFO

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_TOPIC_RAW_TICKS=raw-ticks
KAFKA_TOPIC_ENRICHED_TICKS=enriched-ticks
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_DLQ=dlq

# MinIO (S3-compatible lakehouse)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=market-lake

# Optional Snowflake dual-write (leave empty to disable)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Synthetic generator
TICK_SYMBOLS=AAPL,MSFT,GOOG,AMZN,NVDA
TICK_RATE_PER_SEC=50
